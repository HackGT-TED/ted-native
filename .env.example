# Optional override. Defaults to /api/recordings on the Expo server.
# For native production builds, set this to the deployed HTTPS API URL,
# or configure the expo-router plugin's origin in app.json.
EXPO_PUBLIC_UPLOAD_URL=

# Supabase project URL and public publishable key (never a service-role key).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
