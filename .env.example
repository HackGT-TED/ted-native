# Copy this file to .env and fill in the values. Never commit .env.

# Supabase project URL and public publishable key (never a service-role key).
# Everyone on the team uses the same project; get both values from a teammate or
# Supabase > Project Settings > API.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Story SFX backend (sound effects, descriptions). Leave empty to use the deployed
# server at https://backend-1opa.onrender.com. To test a backend running on your
# computer, set it to http://<your-computer's-LAN-IP>:8000.
EXPO_PUBLIC_API_URL=

# Optional override for recording uploads. Leave empty during development: Expo
# serves /api/recordings from the dev server. For production builds, set this to
# the deployed HTTPS API URL.
EXPO_PUBLIC_UPLOAD_URL=

# Server-only Deepgram API key (Member role or higher) used by /api/deepgram-token to mint
# 30-second tokens for read-along. Never prefix it with EXPO_PUBLIC_ — that would ship it in the app.
DEEPGRAM_API_KEY=
# Optional override for the token endpoint (defaults to /api/deepgram-token on the Expo server).
EXPO_PUBLIC_DEEPGRAM_TOKEN_URL=
